/**
 * The creeper alarm rings when a creeper is near AND it's night,
 * AND NOT while you're inside.
 * alarm = creeper and night and not(inside)
 */
CHIP CreeperAlarm {
    IN creeper, night, inside;
    OUT alarm;

    PARTS:
    // Your parts go here.
}
